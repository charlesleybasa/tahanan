// Copy to Config.xcconfig and fill in. Config.xcconfig is gitignored.
// xcconfig treats "//" as a comment, so write URLs as https:/$()/host

// YES = demo build on bundled JSON mock data (no backend calls).
USE_MOCK_DATA = YES

SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key
API_BASE_URL = https:/$()/localhost:3100/api/v1
